---
import { AUTHOR_NAME, SOCIAL_LINKS } from '../consts';
const today = new Date();
---

<footer>
	<div class="container">
		<p>Copyright {today.getFullYear()} {AUTHOR_NAME}</p>
		<nav>
			{
				SOCIAL_LINKS.map((link) => (
					<a href={link.href} target={link.href.startsWith('mailto:') ? undefined : '_blank'}>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 1.25rem 0 2.2rem;
		color: var(--muted);
	}

	.container {
		width: min(980px, 100% - 2rem);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.92rem;
		flex-wrap: wrap;
	}

	p {
		margin: 0;
	}

	nav {
		display: flex;
		gap: 0.75rem;
	}

	nav a {
		text-decoration: none;
		color: var(--muted);
	}

	nav a:hover {
		color: var(--text);
	}
</style>
